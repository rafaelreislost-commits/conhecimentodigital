{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/obrigado",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.conhecimentodigital.net" }],
      "destination": "https://conhecimentodigital.net/$1",
      "permanent": true
    },
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "conhecimentodigital.vercel.app" }],
      "destination": "https://conhecimentodigital.net/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/meta-page" },
    { "source": "/((?!api/|assets/|tiktok.*\\.txt$).*)", "destination": "/index.html" }
  ]
}
