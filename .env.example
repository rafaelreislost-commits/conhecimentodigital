# Copie para .env.local (dev local via `vercel dev`) e/ou configure na Vercel:
# Project Settings → Environment Variables

# Access Token de PRODUÇÃO ou TESTE do Mercado Pago.
# Painel: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=

# Token do Vercel Blob store (Storage → criar Blob store → aba .env.local).
# Só é necessário para RODAR scripts/upload-materiais.mjs, não precisa estar
# configurado como env var do site em si (a Vercel injeta sozinha em runtime
# quando o Blob store está conectado ao projeto).
BLOB_READ_WRITE_TOKEN=

# API key do Resend (https://resend.com/api-keys), usada pelo webhook para
# mandar o e-mail com os links de download após o pagamento aprovado.
RESEND_API_KEY=

# Remetente do e-mail. Enquanto não tiver domínio verificado no Resend, use
# o padrão de testes "Mundo dos Blocos <onboarding@resend.dev>" (só entrega
# para o e-mail da sua própria conta Resend). Depois de verificar seu domínio,
# troque para algo como "Mundo dos Blocos <materiais@seudominio.com>".
EMAIL_REMETENTE=Mundo dos Blocos <onboarding@resend.dev>
